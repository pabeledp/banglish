# Server Port
PORT=3000

# Meta WhatsApp Webhook Verify Token (Set this same token in Meta Developer Portal)
WEBHOOK_VERIFY_TOKEN=banglish_keyboard_2026

# Meta WhatsApp Cloud API Permanent/System User Access Token
WHATSAPP_TOKEN=your_meta_whatsapp_token_here

# Meta WhatsApp Phone Number ID (from WhatsApp App Dashboard)
PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# WhatsApp API Version (default: v20.0)
META_GRAPH_API_VERSION=v20.0
